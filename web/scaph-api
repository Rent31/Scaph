class ReplicationEngine(threading.Thread):
    """Simulates async cross-zone replication and tracks lag."""

    def __init__(self, interval=20):
        super().__init__(daemon=True, name="replication-engine")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        with LOCK:
            for bucket_name, rep in REPLICATION.items():
                status = rep["status"]
                lag = status.get("replication_lag_seconds", 0)
                lag = max(0, lag - 20)
                status["replication_lag_seconds"] = lag
                status["last_sync"] = _now_iso()
                if lag == 0:
                    status["state"] = "OK"
                    status["pending_objects"] = 0


