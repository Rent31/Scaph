# Subsystem: KMS / SSE-KMS
# ---------------------------------------------------------------------------

def _kms_encrypt(key_id, plaintext):
    with LOCK:
        key = KMS_KEYS.get(key_id)
        if not key or key["state"] != "enabled":
            return None
        material = base64.b64decode(key["key_material"])
        cipher = bytes(b ^ material[i % len(material)]
                       for i, b in enumerate(plaintext))
        return base64.b64encode(cipher).decode()


def _kms_decrypt(key_id, ciphertext_b64):
    with LOCK:
        key = KMS_KEYS.get(key_id)
        if not key or key["state"] != "enabled":
            return None
        material = base64.b64decode(key["key_material"])
        cipher = base64.b64decode(ciphertext_b64)
        plain = bytes(b ^ material[i % len(material)]
                      for i, b in enumerate(cipher))
        return plain


