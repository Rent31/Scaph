            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            pol = LIFECYCLE_POLICIES.get(bucket_name, {"rules": []})
            self._send_json(200, pol)
            return

        # Notifications
        if path == "/api/notifications/history":
            limit = int(query.get("limit", [50])[0])
            self._send_json(200, NOTIFICATION_HISTORY[:limit])
            return

        # KMS
        if path == "/api/kms/keys":
            keys_out = [{k: v for k, v in key.items() if k != "key_material"}
                        for key in KMS_KEYS.values()]
            self._send_json(200, keys_out)
            return
        if len(parts) == 5 and parts[0] == "api" and parts[1] == "kms" \
                and parts[2] == "keys":
            key_id = parts[3]
            sub = parts[4]
            key = KMS_KEYS.get(key_id)
            if key is None:
                self.send_error(404, "key not found")
                return
            if sub == "enable":
                key["state"] = "enabled"
                self._send_json(200, {"status": "ok", "state": "enabled"})
                return
            if sub == "disable":
                key["state"] = "disabled"
                self._send_json(200, {"status": "ok", "state": "disabled"})
                return
            if sub == "rotate":
                key["key_material"] = base64.b64encode(os.urandom(32)).decode()
                key["created"] = _now_iso()
                self._send_json(200, {"status": "ok", "rotated": True})
                return

        # Replication
        if path == "/api/replication":
            self._send_json(200, REPLICATION)
            return

        # DR
        if path == "/api/dr":
            self._send_json(200, DR_STATE)
