            self._send_json(200, AUDIT_LOG[:limit])
            return
        if path == "/api/invoices":
            self._send_json(200, INVOICES)
            return
        if path == "/api/usage":
            tenant = _tenant_from_headers(self.headers)
            if tenant:
                self._send_json(200, USAGE.get(tenant, USAGE[list(USAGE)[0]]))
                return
            self._send_json(200, USAGE)
            return
        if path == "/api/me":
            self._send_json(200, {"tenant": "tenant-a",
                                  "user": "admin@example.com"})
            return

        # Lifecycle
        if path == "/api/lifecycle/history":
            self._send_json(200, LIFECYCLE_HISTORY)
