class Handler(BaseHTTPRequestHandler):
    server_version = "ScaphAPI/1.0"

    def log_message(self, fmt, *args):
        return

    def _send_json(self, code, data):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers",
                         "Content-Type, X-Tenant, Authorization, x-amz-server-side-encryption, x-amz-server-side-encryption-aws-kms-key-id")
        self.send_header("Access-Control-Allow-Methods",
                         "GET, POST, PUT, DELETE, OPTIONS")
        self.end_headers()
        self.wfile.write(body)

    def _send_file(self, path, content_type):
        try:
            with open(path, "rb") as f:
                body = f.read()
        except OSError:
            self.send_error(404, "not found")
            return
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_body(self):
        length = int(self.headers.get("Content-Length", 0))
        return self.rfile.read(length) if length else b""

    def _parse_json(self):
        body = self._read_body()
        try:
            return json.loads(body) if body else {}
        except ValueError:
            return {}

    def _route(self):
        path = urlparse(self.path).path
        return [p for p in path.split("/") if p]

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers",
                         "Content-Type, X-Tenant, Authorization, x-amz-server-side-encryption, x-amz-server-side-encryption-aws-kms-key-id")
        self.send_header("Access-Control-Allow-Methods",
                         "GET, POST, PUT, DELETE, OPTIONS")
        self.end_headers()

    def do_GET(self):
        parts = self._route()
        path = self.path.split("?", 1)[0]
        query = parse_qs(urlparse(self.path).query)

        # Static files
        if path == "/" or path == "/index.html":
            self._send_file(os.path.join(WEB_ROOT, "console", "index.html"),
                            "text/html")
            return
        if path.startswith("/console/") or path.startswith("/billing/") \
                or path.startswith("/shared/"):
            rel = path.lstrip("/")
            if path.endswith("/"):
                rel = rel + "index.html"
            self._send_file(os.path.join(WEB_ROOT, rel),
                            "text/html" if rel.endswith(".html") else
                            "text/css" if rel.endswith(".css") else
                            "application/javascript" if rel.endswith(".js")
                            else "text/plain")
            return
        if path == "/api/openapi.json":
            self._send_json(200, OPENAPI)
            return

        tenant = _tenant_from_headers(self.headers)
        if not _rate_limit_allow(tenant):
            self._send_json(429, {"error": "rate limit exceeded",
                                   "message": "too many requests"})
            return

        # Cluster
        if path == "/api/cluster/health":
            CLUSTER_HEALTH["updated"] = _now_iso()
            self._send_json(200, CLUSTER_HEALTH)
            return
        if path == "/api/nodes":
            self._send_json(200, NODES)
            return
        if path == "/api/disks":
            self._send_json(200, DISKS)
            return
        if path == "/api/pools":
            self._send_json(200, POOLS)
            return
        if path == "/api/erasure-profiles":
            self._send_json(200, ERASURE_PROFILES)
            return
        if path == "/api/recovery":
            self._send_json(200, RECOVERY)
            return
        if path == "/api/scrubbing":
            self._send_json(200, SCRUBBING)
            return

        # Buckets
        if path == "/api/buckets":
            self._send_json(200, BUCKETS)
            return
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "buckets":
            bucket_name = parts[2]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            if query.get("list-objects"):
                objs = OBJECTS.get(bucket_name, {})
                rows = [{"key": k, **v} for k, v in objs.items()]
                self._send_json(200, {"bucket": bucket_name, "objects": rows})
                return
            if query.get("legal-hold") and query.get("key"):
                key = query.get("key")[0]
                held = OBJECT_LEGAL_HOLD.get((bucket_name, key), False)
                self._send_json(200, {"bucket": bucket_name, "key": key,
                                      "legal_hold": held})
                return
            if query.get("access-logs"):
                logs = ACCESS_LOGS.get(bucket_name, [])
                self._send_json(200, {"logs": logs})
                return
            if query.get("website"):
                self._send_json(200, WEBSITE_CONFIG.get(bucket_name, {}))
                return
            self._send_json(200, bucket)
            return

        # Tenants
        if path == "/api/tenants":
            self._send_json(200, TENANTS)
            return
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "tenants":
            tenant_id = parts[2]
            tenant = next((t for t in TENANTS if t["id"] == tenant_id), None)
            if tenant is None:
                self.send_error(404, "tenant not found")
                return
            self._send_json(200, tenant)
            return
        if path == "/api/users":
            self._send_json(200, USERS)
            return
        if path == "/api/keys":
            tenant = _tenant_from_headers(self.headers)
            keys = [k for k in KEYS if k["tenant"] == tenant]
            self._send_json(200, keys)
            return
        if path == "/api/audit-log":
