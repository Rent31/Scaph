# ---------------------------------------------------------------------------

class AutoTieringEngine(threading.Thread):
    """Transitions objects between tiers based on access frequency."""

    def __init__(self, interval=45):
        super().__init__(daemon=True, name="auto-tiering")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        with LOCK:
            for bucket_name, policy in AUTO_TIERING_POLICIES.items():
                if not policy.get("enabled"):
                    continue
                objs = OBJECTS.get(bucket_name, {})
                transitions = []
                for key, meta in objs.items():
                    current = meta["storage_class"]
                    last_access = meta.get("last_access")
                    if not last_access:
                        continue
                    try:
                        dt = datetime.fromisoformat(
                            last_access.replace("Z", "+00:00"))
                    except ValueError:
                        continue
                    age_days = (datetime.now(timezone.utc) - dt).days
                    for rule in policy.get("rules", []):
                        if current == rule["from"] and age_days >= rule["access_days"]:
                            target = rule["to"]
                            meta["storage_class"] = target
                            transitions.append({
                                "bucket": bucket_name, "key": key,
                                "from": current, "to": target,
                                "reason": "auto-tiering: %d days since access" % age_days,
                            })
                            break
                if transitions:
                    AUTO_TIERING_RUN_HISTORY.insert(0, {
                        "time": _now_iso(),
                        "bucket": bucket_name,
                        "transitions": transitions,
                    })
                    if len(AUTO_TIERING_RUN_HISTORY) > 100:
                        del AUTO_TIERING_RUN_HISTORY[100:]


_auto_tiering_engine = AutoTieringEngine()
