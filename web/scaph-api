# ---------------------------------------------------------------------------

class SecurityScanner(threading.Thread):
    """Scans buckets and tenants for security issues."""

    def __init__(self, interval=120):
        super().__init__(daemon=True, name="security-scanner")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        with LOCK:
            new_findings = []
            # Check for buckets without versioning or object lock
            for b in BUCKETS:
                if b.get("versioning") != "Enabled":
                    new_findings.append({
                        "id": "sec-" + str(len(SECURITY_FINDINGS) + len(new_findings) + 1),
                        "time": _now_iso(),
                        "severity": "medium",
                        "resource": "bucket/" + b["name"],
                        "issue": "versioning not enabled",
                        "recommendation": "enable versioning for ransomware protection",
                        "state": "open",
                    })
                if b.get("object_lock") == "Disabled":
                    new_findings.append({
                        "id": "sec-" + str(len(SECURITY_FINDINGS) + len(new_findings) + 1),
                        "time": _now_iso(),
                        "severity": "low",
                        "resource": "bucket/" + b["name"],
                        "issue": "object lock not enabled",
                        "recommendation": "enable object lock for WORM protection",
                        "state": "open",
                    })
            # Check for keys older than 90 days
            for k in KEYS:
                try:
                    created = datetime.fromisoformat(k["created"])
                    if (datetime.now(timezone.utc) - created).days > 90:
                        new_findings.append({
                            "id": "sec-" + str(len(SECURITY_FINDINGS) + len(new_findings) + 1),
                            "time": _now_iso(),
                            "severity": "medium",
                            "resource": "key/" + k["access_key"],
                            "issue": "access key older than 90 days without rotation",
                            "recommendation": "rotate access keys",
                            "state": "open",
                        })
                except ValueError:
                    pass
            if new_findings:
                SECURITY_FINDINGS[:] = [f for f in SECURITY_FINDINGS if f["state"] != "resolved"]
                SECURITY_FINDINGS[:] = new_findings + SECURITY_FINDINGS
                if len(SECURITY_FINDINGS) > 200:
                    del SECURITY_FINDINGS[200:]


_security_scanner = SecurityScanner()
_security_scanner.start()


