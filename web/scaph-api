    def do_POST(self):
        try:
            self._do_post_impl()
        except Exception as e:
            try:
                self._send_json(500, {"error": "internal error",
                                       "message": str(e)})
            except Exception:
                pass

    def _do_post_impl(self):
        parts = self._route()
        path = self.path.split("?", 1)[0]
        self._raw_body = self._read_body()
        payload = json.loads(self._raw_body) if self._raw_body else {}
        tenant = _tenant_from_headers(self.headers)

        if not _rate_limit_allow(tenant):
            self._send_json(429, {"error": "rate limit exceeded",
                                   "message": "too many requests"})
            return

        # Presigned URL
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "buckets":
            bucket_name = parts[2]
            sub = parts[3]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            actor = payload.get("actor", "admin@example.com")

            if sub == "lifecycle":
                LIFECYCLE_POLICIES[bucket_name] = payload
                _audit(actor, "bucket.lifecycle.put", bucket_name)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "notifications":
                BUCKET_NOTIFICATIONS[bucket_name] = payload
                _audit(actor, "bucket.notification.put", bucket_name)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "presigned-url":
                key = payload.get("key", "object")
                method = payload.get("method", "GET")
                expiry = int(payload.get("expiry", 3600))
                token = hashlib.sha256(
                    (bucket_name + key + str(expiry) + SECRET).encode()
                ).hexdigest()[:32]
                url = ("https://{bucket}.scaph.example.com/{key}"
                       "?X-Scaph-Token={token}".format(
                           bucket=bucket_name, key=key, token=token))
                with GRANTS_LOCK:
                    PRESIGNED_GRANTS[token] = {
                        "bucket": bucket_name, "key": key,
                        "method": method,
                        "expires_at": (
                            datetime.now(timezone.utc) +
                            timedelta(seconds=expiry)).strftime(
                                "%Y-%m-%dT%H:%M:%SZ"),
                    }
                _audit(actor, "bucket.presigned-url",
                       bucket_name + "/" + key)
                self._send_json(200, {
                    "url": url, "method": method, "expires_in": expiry,
                    "token": token,
                })
                return
            if sub == "website":
                WEBSITE_CONFIG[bucket_name] = payload
                _audit(actor, "bucket.website.put", bucket_name)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "legal-hold":
                key = payload.get("key")
                enabled = bool(payload.get("enabled", True))
                if key:
                    OBJECT_LEGAL_HOLD[(bucket_name, key)] = enabled
                else:
                    bucket["legal_hold"] = enabled
                _audit(actor, "bucket.legal-hold", bucket_name + "/" + str(key))
                self._send_json(200, {"status": "ok", "legal_hold": enabled})
                return

        # Object put (with quota enforcement and SSE-KMS)
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "objects":
            bucket_name = parts[2]
            key = parts[3]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            object_size = int(self.headers.get("Content-Length", 0))
            allowed, reason = _check_quota(tenant, object_size)
            if not allowed:
                _audit(tenant, "object.put", bucket_name + "/" + key,
                       "rejected: " + reason)
                self._send_json(403, {"error": "quota exceeded",
                                       "message": reason})
                return
            kms_key_id = self.headers.get("x-amz-server-side-encryption-aws-kms-key-id")
            sse_kms = self.headers.get("x-amz-server-side-encryption")
            body = self._raw_body
            if sse_kms == "aws:kms" and kms_key_id:
                cipher = _kms_encrypt(kms_key_id, body)
                if cipher is None:
                    self._send_json(400, {"error": "kms key unavailable"})
                    return
                with LOCK:
                    KMS_ENCRYPTED[(bucket_name, key)] = {
                        "key_id": kms_key_id, "ciphertext_b64": cipher,
                        "size": len(body),
                    }
                OBJECTS.setdefault(bucket_name, {})[key] = {
                    "storage_class": bucket["storage_class"],
                    "size": len(body),
                    "last_access": _now_iso(),
                    "versions": 1, "legal_hold": False,
                    "sse_kms": True,
                }
                for t in TENANTS:
                    if t["id"] == bucket["tenant"]:
                        t["used_gb"] = round(
                            t["used_gb"] + len(body) / (1024 * 1024 * 1024), 4)
                        t["object_count"] += 1
                _audit(tenant, "object.put", bucket_name + "/" + key,
                       "ok (sse-kms)")
                self._enqueue_notification(bucket_name, key,
                                           "s3:ObjectCreated:Put")
                self._send_json(200, {"status": "ok", "encrypted": True,
                                      "key_id": kms_key_id})
                return
            else:
                OBJECTS.setdefault(bucket_name, {})[key] = {
                    "storage_class": bucket["storage_class"],
                    "size": len(body),
                    "last_access": _now_iso(),
                    "versions": 1, "legal_hold": False,
                    "sse_kms": False,
                }
                for t in TENANTS:
                    if t["id"] == bucket["tenant"]:
                        t["used_gb"] = round(
                            t["used_gb"] + len(body) / (1024 * 1024 * 1024), 4)
                        t["object_count"] += 1
                _audit(tenant, "object.put", bucket_name + "/" + key, "ok")
                self._enqueue_notification(bucket_name, key,
                                           "s3:ObjectCreated:Put")
                self._send_json(200, {"status": "ok", "encrypted": False})
                return

        # Tenants
        if path == "/admin/tenants":
            new_tenant = {
                "id": "tenant-" + str(len(TENANTS) + 1),
                "name": payload.get("name", "new tenant"),
                "plan": payload.get("plan", "standard"),
                "capacity_gb": payload.get("capacity_gb", 1000),
                "used_gb": 0,
                "object_count": 0,
                "object_limit": 10000000,
                "state": "active",
                "rate_limit_rps": payload.get("rate_limit_rps", 1000),
                "created": datetime.utcnow().strftime("%Y-%m-%d"),
            }
            TENANTS.append(new_tenant)
            _audit("admin", "tenant.create", new_tenant["id"])
            self._send_json(201, new_tenant)
            return

        # Keys
        if path == "/admin/keys":
            new_key = {
                "id": "key-" + str(len(KEYS) + 1),
                "tenant": payload.get("tenant", "tenant-a"),
                "user": payload.get("user", "admin@example.com"),
                "access_key": "SCAPH01" + "".join(
                    str((i * 7) % 10) for i in range(15)),
                "secret_key": "****",
                "created": datetime.utcnow().strftime("%Y-%m-%d"),
                "state": "active",
            }
            KEYS.append(new_key)
            _audit("admin", "key.create", new_key["access_key"])
            self._send_json(201, new_key)
            return

        # KMS key create
        if path == "/admin/kms/keys":
            key_id = "key-" + str(uuid.uuid4())[:8]
            new_key = {
                "id": key_id, "name": payload.get("name", "new-key"),
                "state": "enabled",
                "created": _now_iso(),
                "description": payload.get("description", ""),
                "key_material": base64.b64encode(os.urandom(32)).decode(),
            }
            KMS_KEYS[key_id] = new_key
            _audit("admin", "kms.key.create", key_id)
            out = {k: v for k, v in new_key.items() if k != "key_material"}
            self._send_json(201, out)
            return

        # KMS encrypt/decrypt
        if path == "/api/kms/encrypt":
            key_id = payload.get("key_id")
            plaintext = base64.b64decode(payload.get("plaintext_b64", ""))
            cipher = _kms_encrypt(key_id, plaintext)
            if cipher is None:
                self._send_json(400, {"error": "kms key unavailable"})
                return
            self._send_json(200, {"ciphertext_b64": cipher, "key_id": key_id})
            return
        if path == "/api/kms/decrypt":
            key_id = payload.get("key_id")
            ciphertext = _kms_decrypt(key_id, payload.get("ciphertext_b64", ""))
            if ciphertext is None:
                self._send_json(400, {"error": "kms key unavailable"})
                return
            self._send_json(200, {
                "plaintext_b64": base64.b64encode(ciphertext).decode(),
                "key_id": key_id,
            })
            return

        # Replication config
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "replication":
            bucket_name = parts[2]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            REPLICATION[bucket_name] = {"config": payload, "status": {
                "state": "OK", "last_sync": _now_iso(),
                "pending_objects": 0, "failed_objects": 0,
                "replication_lag_seconds": 0,
            }}
            _audit(tenant, "bucket.replication.put", bucket_name)
            self._send_json(200, {"status": "ok"})
            return

        # Replication (simple path)
        if path == "/api/replication":
            src = payload.get("source_bucket", "tenant-a-backups")
            dst = payload.get("dest_bucket", "tenant-b-media")
            rule_id = payload.get("rule_id", "rep-1")
            REPLICATION[src] = {"config": {"source_bucket": src,
                "dest_bucket": dst, "rule_id": rule_id}, "status": {
                "state": "OK", "last_sync": _now_iso(),
                "pending_objects": 0, "failed_objects": 0,
                "replication_lag_seconds": 0}}
            _audit(tenant, "bucket.replication.put", src)
            self._send_json(200, {"status": "ok"})
            return

        # DR failover / failback
        if path == "/api/dr/failover":
            DR_STATE["state"] = "secondary_active"
            DR_STATE["last_failover"] = _now_iso()
            _audit("admin", "dr.failover", DR_STATE["secondary_zone"])
            self._send_json(200, DR_STATE)
            return
        if path == "/api/dr/failback":
            DR_STATE["state"] = "primary_active"
            DR_STATE["last_failover"] = None
            DR_STATE["failback_in_progress"] = True
            _audit("admin", "dr.failback", DR_STATE["primary_zone"])
            self._send_json(200, DR_STATE)
            return

        # Ransomware drill
        if path == "/api/drills/run":
            drill = {
                "id": "drill-" + str(len(DRILLS) + 1),
                "time": _now_iso(),
                "type": "ransomware_recovery",
                "rpo_minutes": DR_STATE["rpo_minutes"],
                "rto_minutes": DR_STATE["rto_minutes"],
                "state": "completed",
                "result": "pass",
                "objects_verified": sum(len(o) for o in OBJECTS.values()),
                "immutable_objects": sum(1 for o in OBJECTS.values()
                                         for m in o.values()
                                         if m.get("legal_hold")),
            }
            DRILLS.insert(0, drill)
            _audit("admin", "drill.run", drill["id"])
            self._send_json(201, drill)
            return

        # Global LB manual failover
        if path == "/api/global-lb/failover":
            target = payload.get("target", "secondary")
            with LOCK:
                if target == "secondary":
                    GLOBAL_LB["state"] = "secondary_active"
                    GLOBAL_LB["last_failover"] = _now_iso()
                    GLOBAL_LB["failover_count"] += 1
                else:
                    GLOBAL_LB["state"] = "primary_active"
                    GLOBAL_LB["last_failover"] = None
                _audit(tenant, "global-lb.failover.manual",
                       "target=" + target)
            self._send_json(200, GLOBAL_LB)
            return

        # Config backup create
        if path == "/api/config/backup/create":
            with LOCK:
                backup_id = "backup-" + str(len(CONFIG_BACKUPS) + 1)
                CONFIG_BACKUPS.insert(0, {
                    "id": backup_id,
                    "time": _now_iso(),
                    "type": "manual",
                    "size_mb": round(10.0 + len(CONFIG_BACKUPS) * 0.5, 1),
                    "status": "ok",
                    "includes": ["cluster_config", "users", "keys",
                                 "bucket_index", "policies"],
                })
                _audit(tenant, "config.backup.create", backup_id)
            self._send_json(201, {"id": backup_id, "status": "ok"})
            return

        # CDN origin
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "cdn" \
                and parts[2] == "origins":
            bucket_name = parts[3]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            CDN_ORIGINS[bucket_name] = {
                "origin_id": "cdn-" + str(len(CDN_ORIGINS) + 1),
                "domain": "cdn-" + bucket_name + ".scaph.example.com",
                "origin_protocol_policy": payload.get(
                    "origin_protocol_policy", "https-only"),
                "default_ttl_seconds": int(payload.get(
                    "default_ttl_seconds", 86400)),
                "state": "Enabled",
            }
            _audit(tenant, "cdn.origin.create", bucket_name)
            self._send_json(201, CDN_ORIGINS[bucket_name])
            return

        # Auto-tiering policy
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "auto-tiering":
            bucket_name = parts[2]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            enabled = bool(payload.get("enabled", True))
            rules = payload.get("rules", [])
            AUTO_TIERING_POLICIES[bucket_name] = {
                "enabled": enabled, "rules": rules,
            }
            _audit(tenant, "auto-tiering.put", bucket_name)
            self._send_json(200, {"status": "ok", "enabled": enabled})
            return

        # Compliance report generate
        if path == "/api/compliance/reports/generate":
            framework = payload.get("framework", "SOC2")
            report = {
                "id": "comp-" + str(len(COMPLIANCE_REPORTS) + 1),
                "time": _now_iso(),
                "framework": framework,
                "status": "generated",
                "findings": 0,
                "bucket_count": len(BUCKETS),
                "tenant_count": len(TENANTS),
            }
            COMPLIANCE_REPORTS.insert(0, report)
            if len(COMPLIANCE_REPORTS) > 50:
                del COMPLIANCE_REPORTS[50:]
            _audit(tenant, "compliance.report.generate", framework)
            self._send_json(201, report)
            return

        # Security scan run
        if path == "/api/security/scan/run":
            findings_count = len(SECURITY_FINDINGS)
            _audit(tenant, "security.scan.run", "full")
            self._send_json(200, {
                "status": "completed",
                "findings": findings_count,
                "scanned_buckets": len(BUCKETS),
                "scanned_tenants": len(TENANTS),
            })
            return

        # Security finding resolve
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "security" \
                and parts[2] == "findings":
            finding_id = parts[3]
            with LOCK:
                for f in SECURITY_FINDINGS:
                    if f["id"] == finding_id:
                        f["state"] = payload.get("state", "resolved")
                        _audit(tenant, "security.finding.resolve", finding_id)
                        self._send_json(200, {"status": "ok", "state": f["state"]})
                        return
            self.send_error(404, "finding not found")
            return

        # Bucket quarantine
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "quarantine":
            bucket_name = parts[2]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            action = payload.get("action", "quarantine")
            if action == "quarantine":
                BUCKET_QUARANTINE[bucket_name] = {
                    "reason": payload.get("reason", "suspicious activity"),
                    "quarantined_at": _now_iso(),
                    "quarantined_by": tenant,
                }
                bucket["quarantined"] = True
            else:
                BUCKET_QUARANTINE.pop(bucket_name, None)
                bucket["quarantined"] = False
            _audit(tenant, "bucket.quarantine." + action, bucket_name)
            self._send_json(200, {"status": "ok", "action": action})
            return

        # Network policies
        if path == "/api/network/policies":
            tenant_id = payload.get("tenant_id")
            if not tenant_id:
                self._send_json(400, {"error": "tenant_id required"})
                return
            NETWORK_POLICIES[tenant_id] = {
                "allow_list": payload.get("allow_list", []),
                "block_list": payload.get("block_list", []),
                "state": payload.get("state", "Enabled"),
            }
            _audit(tenant, "network.policy.put", tenant_id)
            self._send_json(200, {"status": "ok"})
            return

        # Emergency lock
        if path == "/api/emergency/lock":
            action = payload.get("action", "lock")
            with LOCK:
                if action == "lock":
                    EMERGENCY_LOCK["cluster_locked"] = True
                    EMERGENCY_LOCK["locked_by"] = tenant
                    EMERGENCY_LOCK["locked_at"] = _now_iso()
                    EMERGENCY_LOCK["reason"] = payload.get("reason", "emergency")
                elif action == "unlock":
                    EMERGENCY_LOCK["cluster_locked"] = False
                    EMERGENCY_LOCK["locked_by"] = None
                    EMERGENCY_LOCK["locked_at"] = None
                    EMERGENCY_LOCK["reason"] = None
                _audit(tenant, "emergency.lock." + action, "cluster")
            self._send_json(200, EMERGENCY_LOCK)
            return
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "emergency" \
                and parts[2] == "lock":
            bucket_name = parts[3]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            action = payload.get("action", "lock")
            with LOCK:
                if action == "lock":
                    EMERGENCY_LOCK["bucket_locks"][bucket_name] = {
                        "locked_by": tenant,
                        "locked_at": _now_iso(),
                        "reason": payload.get("reason", "emergency"),
                    }
                    bucket["emergency_locked"] = True
                else:
                    EMERGENCY_LOCK["bucket_locks"].pop(bucket_name, None)
                    bucket["emergency_locked"] = False
                _audit(tenant, "emergency.lock." + action, bucket_name)
            self._send_json(200, {"status": "ok", "action": action})
            return

        # Egress optimizer
        if path == "/api/egress/optimizer/run":
            bucket_name = payload.get("bucket")
            if not bucket_name:
                self._send_json(400, {"error": "bucket required"})
                return
            hints = EGRESS_CACHE_HINTS.get(bucket_name, {})
            _audit(tenant, "egress.optimizer.run", bucket_name)
            self._send_json(200, {
                "bucket": bucket_name,
                "hot_prefixes": hints.get("hot_prefixes", []),
                "cold_prefixes": hints.get("cold_prefixes", []),
                "estimated_savings_percent": hints.get(
                    "estimated_egress_savings_percent", 0),
            })
            return

        self.send_error(404, "not found")

    def do_PUT(self):
        try:
            self._do_put_impl()
        except Exception as e:
            try:
                self._send_json(500, {"error": "internal error",
                                       "message": str(e)})
            except Exception:
                pass

    def _do_put_impl(self):
        parts = self._route()
        path = self.path.split("?", 1)[0]
        payload = self._parse_json()
        actor = payload.get("actor", "admin@example.com")
        tenant = _tenant_from_headers(self.headers)

        if not _rate_limit_allow(tenant):
            self._send_json(429, {"error": "rate limit exceeded",
                                   "message": "too many requests"})
            return

        if len(parts) == 4 and parts[0] == "api" and parts[1] == "buckets":
            bucket_name = parts[2]
            sub = parts[3]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            if sub == "lifecycle":
                LIFECYCLE_POLICIES[bucket_name] = payload
                _audit(actor, "bucket.lifecycle.put", bucket_name)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "notifications":
                BUCKET_NOTIFICATIONS[bucket_name] = payload
                _audit(actor, "bucket.notification.put", bucket_name)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "versioning":
                bucket["versioning"] = payload.get("status", "Enabled")
                _audit(actor, "bucket.versioning.put", bucket_name)
                self._send_json(200, {"status": "ok",
                                       "versioning": bucket["versioning"]})
                return
            if sub == "object-lock":
                bucket["object_lock"] = payload.get("mode", "Disabled")
                _audit(actor, "bucket.object-lock.put", bucket_name)
                self._send_json(200, {"status": "ok",
                                       "object_lock": bucket["object_lock"]})
                return

        # Tenant rate limit / quota
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "tenants":
            tenant_id = parts[2]
            sub = parts[3]
            tenant_obj = next((t for t in TENANTS if t["id"] == tenant_id), None)
            if tenant_obj is None:
                self.send_error(404, "tenant not found")
                return
            if sub == "rate-limit":
                rps = int(payload.get("rate_limit_rps", 1000))
                tenant_obj["rate_limit_rps"] = rps
                _audit(actor, "tenant.rate-limit", tenant_id,
                       str(rps) + " rps")
                self._send_json(200, {"status": "ok",
                                       "rate_limit_rps": rps})
                return
            if sub == "quota":
                tenant_obj["capacity_gb"] = payload.get(
                    "capacity_gb", tenant_obj["capacity_gb"])
                tenant_obj["object_limit"] = payload.get(
                    "object_limit", tenant_obj["object_limit"])
                _audit(actor, "tenant.quota.put", tenant_id)
                self._send_json(200, {"status": "ok",
                                       "capacity_gb": tenant_obj["capacity_gb"],
                                       "object_limit": tenant_obj["object_limit"]})
                return

        # Network policies
        if path == "/api/network/policies":
            tenant_id = payload.get("tenant_id")
            if not tenant_id:
                self._send_json(400, {"error": "tenant_id required"})
                return
            NETWORK_POLICIES[tenant_id] = {
                "allow_list": payload.get("allow_list", []),
                "block_list": payload.get("block_list", []),
                "state": payload.get("state", "Enabled"),
            }
            _audit(actor, "network.policy.put", tenant_id)
            self._send_json(200, {"status": "ok"})
            return

        # Global LB config
        if path == "/api/global-lb":
            GLOBAL_LB["primary_endpoint"] = payload.get(
                "primary_endpoint", GLOBAL_LB["primary_endpoint"])
            GLOBAL_LB["secondary_endpoint"] = payload.get(
                "secondary_endpoint", GLOBAL_LB["secondary_endpoint"])
            GLOBAL_LB["enabled"] = bool(payload.get(
                "enabled", GLOBAL_LB["enabled"]))
            GLOBAL_LB["failover_threshold_seconds"] = int(payload.get(
                "failover_threshold_seconds",
                GLOBAL_LB["failover_threshold_seconds"]))
            _audit(actor, "global-lb.config.put")
            self._send_json(200, GLOBAL_LB)
            return

        # Config backup schedule
        if path == "/api/config/backup/schedule":
            CONFIG_BACKUP_SCHEDULE = payload.get(
                "schedule", CONFIG_BACKUP_SCHEDULE)
            CONFIG_BACKUP_RETENTION_DAYS = int(payload.get(
                "retention_days", CONFIG_BACKUP_RETENTION_DAYS))
            _audit(actor, "config.backup.schedule.put")
            self._send_json(200, {
                "schedule": CONFIG_BACKUP_SCHEDULE,
                "retention_days": CONFIG_BACKUP_RETENTION_DAYS,
            })
            return

        # Auto-tiering via PUT
        if len(parts) == 3 and parts[0] == "api" and parts[1] == "auto-tiering":
            bucket_name = parts[2]
            bucket = next((b for b in BUCKETS if b["name"] == bucket_name), None)
            if bucket is None:
                self.send_error(404, "bucket not found")
                return
            enabled = bool(payload.get("enabled", True))
            rules = payload.get("rules", [])
            AUTO_TIERING_POLICIES[bucket_name] = {
                "enabled": enabled, "rules": rules,
            }
            _audit(actor, "auto-tiering.put", bucket_name)
            self._send_json(200, {"status": "ok", "enabled": enabled})
            return

        # Security finding resolve via PUT
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "security" \
                and parts[2] == "findings":
            finding_id = parts[3]
            with LOCK:
                for f in SECURITY_FINDINGS:
                    if f["id"] == finding_id:
                        f["state"] = payload.get("state", "resolved")
                        _audit(actor, "security.finding.resolve", finding_id)
                        self._send_json(200, {"status": "ok", "state": f["state"]})
                        return
            self.send_error(404, "finding not found")
            return

        self.send_error(404, "not found")

    def do_DELETE(self):
        try:
            self._do_delete_impl()
        except Exception as e:
            try:
                self._send_json(500, {"error": "internal error",
                                       "message": str(e)})
            except Exception:
                pass

    def _do_delete_impl(self):
        parts = self._route()
        path = self.path.split("?", 1)[0]

        if len(parts) == 4 and parts[0] == "api" and parts[1] == "buckets":
            bucket_name = parts[2]
            sub = parts[3]
            if sub == "lifecycle":
                LIFECYCLE_POLICIES.pop(bucket_name, None)
                self._send_json(200, {"status": "ok"})
                return
            if sub == "notifications":
                BUCKET_NOTIFICATIONS.pop(bucket_name, None)
                self._send_json(200, {"status": "ok"})
                return

        # Security finding delete
        if len(parts) == 5 and parts[0] == "api" and parts[1] == "security" \
                and parts[2] == "findings":
            finding_id = parts[3]
            with LOCK:
                for i, f in enumerate(SECURITY_FINDINGS):
                    if f["id"] == finding_id:
                        del SECURITY_FINDINGS[i]
                        self._send_json(200, {"status": "ok"})
                        return
            self.send_error(404, "finding not found")
            return

        # Config backup delete
        if len(parts) == 4 and parts[0] == "api" and parts[1] == "config" \
                and parts[2] == "backup":
            backup_id = parts[3]
            with LOCK:
                for i, b in enumerate(CONFIG_BACKUPS):
                    if b["id"] == backup_id:
                        del CONFIG_BACKUPS[i]
                        self._send_json(200, {"status": "ok"})
                        return
            self.send_error(404, "backup not found")
            return

        self.send_error(404, "not found")

    def _enqueue_notification(self, bucket, key, event):
        notifs = BUCKET_NOTIFICATIONS.get(bucket)
        if not notifs:
            return
        for wh in notifs.get("webhooks", []):
            if wh.get("state") != "Enabled":
                continue
            NOTIFICATION_QUEUE.append({
                "id": "notif-" + str(uuid.uuid4())[:8],
                "bucket": bucket, "key": key, "event": event,
                "topic": wh.get("topic"), "endpoint": wh.get("endpoint"),
                "attempts": 0,
            })


