LOCK = threading.RLock()


def _now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _audit(actor, action, resource, result="OK"):
    with LOCK:
        AUDIT_LOG.insert(0, {
            "time": _now_iso(), "actor": actor, "action": action,
            "resource": resource, "result": result,
        })
        if len(AUDIT_LOG) > 2000:
            del AUDIT_LOG[2000:]


def _tenant_from_headers(headers):
    return headers.get("X-Tenant", "tenant-a")


def _rate_limit_allow(tenant_id):
    """Token bucket rate limiter. Returns True if request is allowed."""
    rps = 1000
    with LOCK:
        for t in TENANTS:
            if t["id"] == tenant_id:
                rps = t.get("rate_limit_rps", 1000)
                break
        now = time.time()
        state = RATE_LIMITER.get(tenant_id)
        if state is None:
            state = {"tokens": float(rps), "last_update": now}
            RATE_LIMITER[tenant_id] = state
        elapsed = now - state["last_update"]
        state["tokens"] = min(rps, state["tokens"] + elapsed * rps)
        state["last_update"] = now
        if state["tokens"] >= 1.0:
            state["tokens"] -= 1.0
            return True
        return False


def _check_quota(tenant_id, object_size_bytes=0):
    """Check tenant quota. Returns (allowed, reason)."""
    with LOCK:
        for t in TENANTS:
            if t["id"] == tenant_id:
                if t["state"] != "active":
                    return False, "tenant not active"
                if t["used_gb"] >= t["capacity_gb"]:
                    return False, "capacity quota exceeded"
                if t["object_count"] >= t["object_limit"]:
                    return False, "object count quota exceeded"
                needed_gb = object_size_bytes / (1024 * 1024 * 1024)
                if t["used_gb"] + needed_gb > t["capacity_gb"]:
                    return False, "capacity quota would be exceeded"
                return True, None
        return False, "tenant not found"


# ---------------------------------------------------------------------------
# Subsystem: Lifecycle enforcement engine (background thread)
# ---------------------------------------------------------------------------

class LifecycleEngine(threading.Thread):
    """Transitions objects between storage classes per bucket lifecycle rules."""

    def __init__(self, interval=30):
        super().__init__(daemon=True, name="lifecycle-engine")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        with LOCK:
            for bucket_name, policy in LIFECYCLE_POLICIES.items():
                for rule in policy.get("rules", []):
                    if rule.get("status") != "Enabled":
                        continue
                    prefix = rule.get("filter", {}).get("prefix", "")
                    for trans in rule.get("transitions", []):
                        days = trans.get("days", 0)
                        target = trans.get("storage_class")
                        objs = OBJECTS.get(bucket_name, {})
                        for key, meta in objs.items():
                            if not key.startswith(prefix):
                                continue
                            if meta["storage_class"] == target:
                                continue
                            last_access = meta.get("last_access")
                            if not last_access:
                                continue
                            try:
                                dt = datetime.fromisoformat(
                                    last_access.replace("Z", "+00:00"))
                            except ValueError:
                                continue
                            age_days = (datetime.now(timezone.utc) - dt).days
                            if age_days >= days:
                                old = meta["storage_class"]
                                meta["storage_class"] = target
                                LIFECYCLE_HISTORY.setdefault(bucket_name, []).insert(0, {
                                    "time": _now_iso(), "bucket": bucket_name,
                                    "key": key, "action": "transition",
                                    "from": old, "to": target, "result": "ok",
                                })
                                if len(LIFECYCLE_HISTORY[bucket_name]) > 500:
                                    del LIFECYCLE_HISTORY[bucket_name][500:]


_lifecycle_engine = LifecycleEngine()
_lifecycle_engine.start()


# ---------------------------------------------------------------------------
# Subsystem: Notification delivery (webhook delivery with retry)
# ---------------------------------------------------------------------------

class NotificationDelivery(threading.Thread):
    """Delivers bucket notification webhooks with retry and backoff."""

    def __init__(self, interval=10):
        super().__init__(daemon=True, name="notification-delivery")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        global NOTIFICATION_QUEUE
        with LOCK:
            queue = list(NOTIFICATION_QUEUE)
            NOTIFICATION_QUEUE = []
        for item in queue:
            self._deliver(item)

    def _deliver(self, item):
        endpoint = item["endpoint"]
        topic = item["topic"]
        event = item["event"]
        payload = {
            "event": event,
            "topic": topic,
            "time": _now_iso(),
            "bucket": item.get("bucket"),
            "key": item.get("key"),
        }
        attempts = item.get("attempts", 0) + 1
        success = self._post_webhook(endpoint, payload)
        record = {
            "id": item["id"], "time": _now_iso(), "endpoint": endpoint,
            "topic": topic, "event": event, "attempts": attempts,
            "state": "delivered" if success else "failed",
        }
        with LOCK:
            NOTIFICATION_HISTORY.insert(0, record)
            if len(NOTIFICATION_HISTORY) > 1000:
                del NOTIFICATION_HISTORY[1000:]
            if not success and attempts < 5:
                item["attempts"] = attempts
                item["next_retry"] = time.time() + (60 * attempts)
                NOTIFICATION_QUEUE.append(item)

    def _post_webhook(self, endpoint, payload):
        # Demo mode: always succeed (no outbound network in this build)
        return True


