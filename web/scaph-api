# Subsystem: Global load balancer health checker
# ---------------------------------------------------------------------------

class GlobalLBHealthChecker(threading.Thread):
    """Periodically checks primary/secondary zone health and triggers failover."""

    def __init__(self, interval=10):
        super().__init__(daemon=True, name="global-lb-health")
        self.interval = interval
        self._stop = threading.Event()

    def stop(self):
        self._stop.set()

    def run(self):
        while not self._stop.wait(self.interval):
            self._tick()

    def _tick(self):
        with LOCK:
            lb = GLOBAL_LB
            if not lb["enabled"]:
                return
            # Simulate health probe: primary stays healthy unless failed over
            primary_healthy = lb["primary_healthy"] and lb["state"] == "primary_active"
            secondary_healthy = lb["secondary_healthy"]
            lb["primary_healthy"] = primary_healthy
            lb["secondary_healthy"] = secondary_healthy

            if lb["state"] == "primary_active" and not primary_healthy:
                # Trigger automatic failover
                lb["state"] = "secondary_active"
                lb["last_failover"] = _now_iso()
                lb["failover_count"] += 1
                _audit("system", "global-lb.failover",
                       "primary->secondary", "auto")
            elif lb["state"] == "secondary_active" and primary_healthy:
                # Auto-failback after recovery
                lb["state"] = "primary_active"
                lb["last_failover"] = None
                _audit("system", "global-lb.failback",
                       "secondary->primary", "auto")


_global_lb_checker = GlobalLBHealthChecker()
